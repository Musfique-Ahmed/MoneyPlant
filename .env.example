# =============================================================================
# MoneyPlant — Environment configuration template
# Copy to .env (backend) and apps/web/.env.local (frontend) and fill values.
# NEVER commit a real .env file.
# =============================================================================

# --- Backend ---

# DATABASE_URL: SQLite default for local dev. Swap to Postgres in production.
# Examples:
#   SQLite:    sqlite:///./moneyplant.db
#   Postgres:  postgresql+psycopg://user:pass@localhost:5432/moneyplant
DATABASE_URL=sqlite:///./moneyplant.db

# CORS: comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000

# Server-side secret used to sign session cookies (when auth is added).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Logging
LOG_LEVEL=INFO
LOG_REDACT_FINANCIAL=true

# --- AI: choose ONE provider as the default ---
# Valid modes: local, openai, anthropic
AI_DEFAULT_MODE=local
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=llama3.1:8b
AI_TIMEOUT_SECONDS=30

# OpenAI — set this ONLY if AI_DEFAULT_MODE=openai
# OPENAI_API_KEY=sk-...

# Anthropic — set this ONLY if AI_DEFAULT_MODE=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Laya (separate from the LLM provider)
# Set to a real HF model id, e.g. "convaiinnovations/laya"
# Leave empty to disable Laya (rule engine still works).
LAYA_MODEL=convaiinnovations/laya
LAYA_DEVICE=cpu
HF_HUB_CACHE=

# --- Frontend (apps/web/.env.local) ---

# Public base URL of the backend. The browser uses this for all API calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public app name (also used in titles).
NEXT_PUBLIC_APP_NAME=MoneyPlant
